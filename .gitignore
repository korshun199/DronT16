# Секреты и production-артефакты защиты
security/
security/*.v16e
security/*activation*.json
security/*.key
security/*.pem
security/view

# Сохранённый образец из другого проекта не публикуется
security_sample/
SECURITY.md

# Локальные видеозаписи и результаты тестов
recordings/
runs/
backups/
*.log

# Все локальные доказательства испытаний лежат в одном месте. Исходные
# захваты, видео и журналы не публикуются; в Git хранится только памятка.
diagnostics/*
!diagnostics/README.md

# Локальные настройки и окружения
.env
# Адрес конкретной Raspberry Pi хранится только на рабочем ноутбуке.
config/deployment.toml
.venv/
__pycache__/
*.pyc
