#!/usr/bin/env bash
# Единая команда стендового теста CRSF takeover.

set -Eeuo pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
SERVICE_NAME="dront16.service"

printf '[FILESAFE TEST] Проект: %s\n' "${PROJECT_DIR}"
printf '[FILESAFE TEST] Сервис: %s\n' "${SERVICE_NAME}"
printf '[FILESAFE TEST] Винты должны быть сняты, дрон закреплён.\n'
printf '[FILESAFE TEST] CH5=ARM, газ около 30%%, CH7=обычная связь.\n'

if [[ "$#" -ne 0 ]]; then
    printf '[FILESAFE TEST] Параметры не нужны: запуск без аргументов.\n' >&2
    exit 2
fi

cd "${PROJECT_DIR}"

printf '[FILESAFE TEST] Перезапуск %s...\n' "${SERVICE_NAME}"
sudo systemctl restart "${SERVICE_NAME}"

if ! systemctl is-active --quiet "${SERVICE_NAME}"; then
    printf '[FILESAFE TEST] ОШИБКА: сервис не запущен.\n' >&2
    sudo systemctl status "${SERVICE_NAME}" --no-pager
    exit 1
fi

printf '[FILESAFE TEST] Сервис запущен. Ctrl+C завершит просмотр журнала.\n'
printf '[FILESAFE TEST] Переключай CH7 для takeover, CH5 для DISARM.\n'
exec sudo journalctl -u "${SERVICE_NAME}" -f -o cat
