#!/usr/bin/env bash
# Цветной запуск полного набора unittest DronT16.

set -o pipefail

PROJECT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
PYTHON_BIN="${PROJECT_DIR}/.venv/bin/python3"

if [[ ! -x "${PYTHON_BIN}" ]]; then
    printf '\033[31m[test] Не найден Python проекта: %s\033[0m\n' "${PYTHON_BIN}" >&2
    exit 1
fi
"${PYTHON_BIN}" -m unittest discover -s "${PROJECT_DIR}/tests" -v 2>&1 | \
    awk '
        /^test[^ ]* \([^)]*\)$/ { next }
        /\.\.\. ok$/ {
            line = $0
            sub(/[.][.][.] ok$/, "", line)
            print line " OK"
            next
        }
        /\.\.\. (FAIL|ERROR|skipped|expected failure)$/ {
            line = $0
            status = toupper($NF)
            sub(/[.][.][.][[:space:]]+(FAIL|ERROR|skipped|expected failure)$/, "", line)
            print line " " status
            next
        }
    ' | \
    sed -E $'s/ OK$/\033[32m OK\033[0m/; s/ (FAIL|ERROR|SKIPPED|FAILURE)$/\033[31m \\1\033[0m/'

# Возвращаем код unittest, а не код sed из конвейера.
exit "${PIPESTATUS[0]}"
